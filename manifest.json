{
  "manifest_version": 3,
  "name": "Vectorizer.io SVG Downloader",
  "version": "1.0.0",
  "description": "Easily download SVG files from vectorizer.io without clicking the official download button",
  "permissions": [
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://www.vectorizer.io/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.vectorizer.io/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "download-svg": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Download SVG from vectorizer.io"
    }
  }
}
